# --- Frontend (Vite) ---
# Only needed if the API isn't served from the same origin (e.g. local dev
# running `vite` and `node server/dev.js` on different ports). In production
# on Vercel, frontend and API share an origin, so this can stay unset.
VITE_API_BASE_URL=/api

# --- Backend (Express, served via api/[...all].js on Vercel) ---
# Postgres connection string. In production this is auto-injected by the
# Vercel Neon integration; for local dev use a Neon dev branch or any Postgres.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Any long random string — signs admin login JWTs
JWT_SECRET="change-me-to-a-long-random-string"

# Comma-separated allowed origins for local dev CORS (unused in production, same-origin)
FRONTEND_ORIGIN="http://localhost:5173"

# Auto-injected by the Vercel Blob store integration; needed for venue photo uploads
BLOB_READ_WRITE_TOKEN=""

# Only used by prisma/seed.js — override the default seeded admin credentials
ADMIN_SEED_EMAIL="admin@hotelmetropolishubli.com"
ADMIN_SEED_PASSWORD="admin123"
